# Port for the Fastify server (avoid :4000 — Local by Flywheel uses it)
PORT=4050
NODE_ENV=development

# HMAC secret used to sign click IDs. Generate with: openssl rand -hex 32
CLICK_HMAC_SECRET=dev-secret-change-me-to-a-32-byte-hex-in-production

# Base URL of the public web app (used for CORS origin)
WEB_ORIGIN=http://localhost:3000

# ---- Supplier credentials (add only what you have) ----
# Travelpayouts (flights + hotels meta-aggregator)
TRAVELPAYOUTS_API_TOKEN=
TRAVELPAYOUTS_MARKER=

# Booking.com Demand API / Affiliate
BOOKING_AFFILIATE_ID=
BOOKING_API_TOKEN=
BOOKING_USE_SANDBOX=true

# Viator (activities)
VIATOR_API_KEY=
VIATOR_PARTNER_ID=

# DiscoverCars
DISCOVERCARS_PARTNER_ID=

# Kiwi.com (flights)
KIWI_AFFILIATE_ID=
